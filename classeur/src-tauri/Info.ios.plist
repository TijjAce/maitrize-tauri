<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Ce que le classeur demande à l'iPad et à l'iPhone, et pourquoi.

  Fusionné dans l'Info.plist par Tauri : il survit à une régénération du
  projet Xcode.

  Une seule autorisation : l'appareil photo, pour photographier un objet, un
  lieu, une personne et en faire une case. La photo reste sur l'appareil.
  Choisir une photo existante passe par le sélecteur d'iOS, qui ne demande
  rien.

  Les Documents de l'application se montrent dans l'app Fichiers : c'est là
  qu'un classeur exporté se pose, et de là qu'il part par AirDrop vers
  l'ordinateur.

  La vie en « scènes », qu'iOS 27 exige : voir le compagnon.
-->
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleDisplayName</key>
	<string>MaitrizeV2 Classeur</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Pour photographier un objet, un lieu ou une personne et en faire une case du classeur. La photo reste sur l'appareil.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Pour choisir une photo et en faire une case du classeur. Elle reste sur l'appareil.</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
