{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maitrize Classeur",
  "version": "1.0.0",
  "identifier": "fr.clementsapp.maitrize.classeur",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5206",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Classeur",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "developmentTeam": "AZZ5PTTNXH",
      "bundleVersion": "1",
      "minimumSystemVersion": "15.0"
    }
  }
}
